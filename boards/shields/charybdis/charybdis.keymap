#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DVORAK  0
#define QWERTY  1
#define NAV     2
#define MEDIA   3
#define MOUSE   4
#define SCROLL  5
#define NUMBERS 6
#define SYMBOLS 7
#define FUN     8

/ {
    macros {
        bt_0: bt_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 0>;
        };

        bt_1: bt_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 1>;
        };

        bt_2: bt_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 2>;
        };

        bt_3: bt_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 3>;
        };

        bt_4: bt_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 4>;
        };
    };

    behaviors {
        hrm: home_row_mod {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
        };

        hrml: home_row_mod_layer {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
        };

        ltq: layer_tap_quick {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <0>;
        };

        bluetooth_0: bluetooth_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&bt_0>, <&bt BT_DISC 0>;
        };

        bluetooth_1: bluetooth_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&bt_1>, <&bt BT_DISC 1>;
        };

        bluetooth_2: bluetooth_2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&bt_2>, <&bt BT_DISC 2>;
        };

        bluetooth_3: bluetooth_3 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&bt_3>, <&bt BT_DISC 3>;
        };

        bluetooth_4: bluetooth_4 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&bt_4>, <&bt BT_DISC 4>;
        };

        bt_clr_all: bluetooth_clr_all {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR>, <&bt BT_CLR_ALL>;
        };

        bg: bg {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&none>, <&bootloader>;
        };

        rg: rg {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&none>, <&sys_reset>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Dvorak {
            bindings = <
                &none       &kp DOT             &kp COMMA   &kp SEMI        &kp P           &kp Y   &kp F                   &kp G               &kp C       &kp H       &kp L           &kp MINUS
                &kp CAPS    &hrm LGUI A         &hrm LALT O &hrm LCTL E     &hrm LSFT U     &kp I   &kp D                   &hrm RSFT R         &hrm RCTL T &hrm LALT N &hrm RGUI S     &kp SQT
                &none       &hrml MOUSE FSLH    &hrm RALT Q &kp J           &kp K           &kp X   &kp B                   &kp M               &kp W       &hrm RALT V &hrml MOUSE Z   &none
                                                            &ltq MEDIA ESC  &ltq NAV SPACE  &kp TAB &ltq SYMBOLS BACKSPACE  &ltq NUMBERS RETURN
            >;
        };

        Qwerty {
            bindings = <
                &none       &kp Q            &kp W      &kp E           &kp R           &kp T   &kp Y                   &kp U               &kp I       &kp O           &kp P               &kp MINUS
                &kp CAPS    &hrm LGUI A     &hrm LALT S &hrm LCTL D     &hrm LSFT F     &kp G   &kp H                   &hrm RSFT J         &hrm RCTL K &hrm LALT L     &hrm RGUI SEMI      &kp SQT
                &none       &hrml MOUSE Z   &hrm RALT X &kp C           &kp V           &kp B   &kp N                   &kp M               &kp COMMA   &hrm RALT DOT   &hrml MOUSE FSLH    &none
                                                        &ltq MEDIA ESC  &ltq NAV SPACE  &kp TAB &ltq SYMBOLS BACKSPACE  &ltq NUMBERS RETURN
            >;
        };

        Nav {
            bindings = <
                &bg             &none       &none       &none       &none       &none   &none       &none       &none       &none       &none   &none
                &rg             &kp LGUI    &kp LALT    &kp LCTL    &kp LSFT    &none   &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT   &kp INS &none
                &studio_unlock  &none       &kp RALT    &none       &none       &none   &kp HOME    &kp PG_DN   &kp PG_UP   &kp END     &none   &none
                                                        &none       &none       &none   &kp DEL     &kp RETURN
            >;
        };

        Media {
            bindings = <
                &none       &none   &kt LALT    &kt LCTL    &kt LSFT    &none   &none           &kp C_BRI_DN        &kp C_BRI_UP    &kp C_MUTE      &none           &bt_clr_all
                &to QWERTY  &none   &mkp MB3    &mkp MB2    &mkp MB1    &none   &kp C_PREV      &kp C_VOL_DN        &kp C_VOLUME_UP &kp C_NEXT      &out OUT_USB    &none
                &to DVORAK  &none   &kp RALT    &mkp MB5    &mkp MB4    &none   &bluetooth_0    &bluetooth_1        &bluetooth_2    &bluetooth_3    &bluetooth_4    &none
                                                &none       &none       &none   &kp C_STOP      &kp C_PLAY_PAUSE
            >;
        };

        Mouse {
            bindings = <
                &none   &none       &kp RALT    &none       &none       &none       &none       &none       &none   &none       &none   &none
                &none   &kp LGUI    &kp LALT    &kp LCTL    &kp LSFT    &none       &none       &none       &none   &none       &none   &none
                &none   &none       &mo SCROLL  &mkp MB5    &mkp MB4    &none       &none       &none       &none   &mo SCROLL  &none   &none
                                                &mkp MB3    &mkp MB1    &mkp MB2    &mkp MB2    &mkp MB1
            >;
        };

        Scroll {
            bindings = <
                &none   &none       &kp RALT    &none       &none       &none       &none       &none       &none   &none   &none   &none
                &none   &kp LGUI    &kp LALT    &kp LCTL    &kp LSFT    &none       &none       &none       &none   &none   &none   &none
                &none   &none       &none       &mkp MB5    &mkp MB4    &none       &none       &none       &none   &none   &none   &none
                                                &mkp MB3    &mkp MB1    &mkp MB2    &mkp MB2    &mkp MB1
            >;
        };

        Numbers {
            bindings = <
                &none   &kp APOS    &kp N7  &kp N8      &kp N9  &kp BSLH    &none           &none       &none       &kp COMMA   &kp DOT     &bg
                &none   &kp LBKT    &kp N4  &kp N5      &kp N6  &kp RBKT    &mo FUN         &kp RSHFT   &kp RCTRL   &kp LALT    &kp RGUI    &rg
                &none   &kp NUBS    &kp N1  &kp N2      &kp N3  &kp GRAVE   &none           &none       &none       &kp RALT    &kp FSLH    &studio_unlock
                                            &kp EQUAL   &kp N0  &kp MINUS   &kp BACKSPACE   &kp ENTER
            >;
        };

        Symbols {
            bindings = <
                &none &kp RA(APOS)  &kp LS(N7)  &kp LS(N8)    &kp LS(N9)  &kp RA(BSLH)  &none &none     &none     &none     &none     &none
                &none &kp RA(LBKT)  &kp LS(N4)  &kp LS(N5)    &kp LS(N6)  &kp RA(RBKT)  &none &kp RSFT  &kp RCTRL &kp LALT  &kp RGUI  &none
                &none &kp LS(NUBS)  &kp LS(N1)  &kp LS(N2)    &kp RA(N3)  &kp RA(GRAVE) &none &none     &none     &kp RALT  &none     &none
                                                &kp LS(EQUAL) &kp LS(N0)  &kp LS(MINUS) &none &none
            >;
        };

        Fun {
            bindings = <
                &none   &kp F12 &kp F7  &kp F8  &kp F9  &kp PRINTSCREEN &none   &none       &none       &none       &none       &none
                &none   &kp F11 &kp F4  &kp F5  &kp F6  &none           &none   &kp RSHFT   &kp RCTRL   &kp LALT    &kp RGUI    &none
                &none   &kp F10 &kp F1  &kp F2  &kp F3  &none           &none   &none       &none       &kp RALT    &none       &none
                                        &none   &none   &none           &none   &none
            >;
        };
    };
};
