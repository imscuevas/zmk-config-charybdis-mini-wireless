#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp TAB     &kp DOT     &kp COMMA   &kp SEMI    &kp P       &kp Y   &kp F           &kp G       &kp C   &kp H   &kp L   &kp MINUS
                &kp CAPS    &kp A       &kp O       &kp E       &kp U       &kp I   &kp D           &kp R       &kp T   &kp N   &kp S   &kp SQT
                &bootloader &kp FSLH    &kp Q       &kp J       &kp K       &kp X   &kp B           &kp M       &kp W   &kp V   &kp Z   &bootloader
                                                    &kp ESC     &kp SPACE   &kp TAB &kp BACKSPACE   &kp RETURN
            >;
        };
    };
};
