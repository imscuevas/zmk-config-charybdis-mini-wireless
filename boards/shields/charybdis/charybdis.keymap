#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        hrm: home_row_mod {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
        };

        ltq: layer_tap_quick {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Alpha {
            bindings = <
                &kp TAB     &kp DOT     &kp COMMA   &kp SEMI    &kp P           &kp Y   &kp F           &kp G       &kp C       &kp H       &kp L       &kp MINUS
                &kp CAPS    &hrm LGUI A &hrm LALT O &hrm LCTL E &hrm LSFT U     &kp I   &kp D           &hrm RSFT R &hrm RCTL T &hrm LALT N &hrm RGUI S &kp SQT
                &bootloader &kp FSLH    &hrm RALT Q &kp J       &kp K           &kp X   &kp B           &kp M       &kp W       &hrm RALT V &kp Z       &bootloader
                                                    &kp ESC     &ltq 1 SPACE    &kp TAB &kp BACKSPACE   &kp RETURN
            >;
        };

        Nav {
            bindings = <
                &bootloader &none       &none       &none       &none       &none   &none       &none       &none       &none       &none   &none
                &none       &kp LGUI    &kp LALT    &kp LCTL    &kp LSFT    &none   &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT   &kp INS &none
                &none       &none       &kp RALT    &none       &none       &none   &kp HOME    &kp PG_DN   &kp PG_UP   &kp END     &none   &none
                                                    &none       &none       &none   &kp DEL     &kp RETURN
            >;
        };
    };
};
