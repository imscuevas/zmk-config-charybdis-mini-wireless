#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    macros {
        bt_0: bt_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 0>;
        };

        bt_1: bt_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 1>;
        };

        bt_2: bt_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 2>;
        };

        bt_3: bt_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 3>;
        };

        bt_4: bt_4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE &bt BT_SEL 4>;
        };
    };

    behaviors {
        hrm: home_row_mod {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
        };

        ltq: layer_tap_quick {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <0>;
        };

        bluetooth_0: bluetooth_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&bt_0>, <&bt BT_DISC 0>;
        };

        bluetooth_1: bluetooth_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&bt_1>, <&bt BT_DISC 1>;
        };

        bluetooth_2: bluetooth_2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&bt_2>, <&bt BT_DISC 2>;
        };

        bluetooth_3: bluetooth_3 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&bt_3>, <&bt BT_DISC 3>;
        };

        bluetooth_4: bluetooth_4 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&bt_4>, <&bt BT_DISC 4>;
        };

        bt_clr_all: bluetooth_clr_all {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR>, <&bt BT_CLR_ALL>;
        };

        bg: bg {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&none>, <&bootloader>;
        };

        rg: rg {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&none>, <&sys_reset>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Alpha {
            bindings = <
                &kp TAB     &kp DOT     &kp COMMA   &kp SEMI    &kp P           &kp Y   &kp F               &kp G           &kp C       &kp H       &kp L       &kp MINUS
                &kp CAPS    &hrm LGUI A &hrm LALT O &hrm LCTL E &hrm LSFT U     &kp I   &kp D               &hrm RSFT R     &hrm RCTL T &hrm LALT N &hrm RGUI S &kp SQT
                &bootloader &kp FSLH    &hrm RALT Q &kp J       &kp K           &kp X   &kp B               &kp M           &kp W       &hrm RALT V &kp Z       &bootloader
                                                    &ltq 2 ESC  &ltq 1 SPACE    &kp TAB &ltq 4 BACKSPACE    &ltq 3 RETURN   
            >;
        };

        Nav {
            bindings = <
                &bg     &none       &none       &none       &none       &none   &none       &none       &none       &none       &none   &none
                &rg     &kp LGUI    &kp LALT    &kp LCTL    &kp LSFT    &none   &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT   &kp INS &none
                &none   &none       &kp RALT    &none       &none       &none   &kp HOME    &kp PG_DN   &kp PG_UP   &kp END     &none   &none
                                                &none       &none       &none   &kp DEL     &kp RETURN
            >;
        };

        Media {
            bindings = <
                &none   &none   &kt LALT    &kt LCTL    &kt LSFT    &none   &none           &kp C_BRI_DN        &kp C_BRI_UP    &kp C_MUTE      &none           &bt_clr_all
                &none   &none   &mkp MB3    &mkp MB2    &mkp MB1    &none   &kp C_PREV      &kp C_VOL_DN        &kp C_VOLUME_UP &kp C_NEXT      &out OUT_USB    &none
                &none   &none   &kp RALT    &mkp MB5    &mkp MB4    &none   &bluetooth_0    &bluetooth_1        &bluetooth_2    &bluetooth_3    &bluetooth_4    &none
                                            &none       &none       &none   &kp C_STOP      &kp C_PLAY_PAUSE
            >;
        };

        Numbers {
            bindings = <
                &none   &kp APOS    &kp N7  &kp N8      &kp N9  &kp BSLH    &none           &none       &none       &kp COMMA   &kp DOT     &bg
                &none   &kp LBKT    &kp N4  &kp N5      &kp N6  &kp RBKT    &none           &kp RSHFT   &kp RCTRL   &kp LALT    &kp RGUI    &rg
                &none   &kp NUBS    &kp N1  &kp N2      &kp N3  &kp GRAVE   &none           &none       &none       &kp RALT    &kp FSLH    &none
                                            &kp EQUAL   &kp N0  &kp MINUS   &kp BACKSPACE   &kp ENTER
            >;
        };

        Symbols {
            bindings = <
                &none   &kp EQUAL       &kp LS(N1)      &kp RA(LBKT)    &kp RA(RBKT)    &none   &none   &none       &none       &none       &none       &none
                &none   &kp LS(EQUAL)   &kp LS(MINUS)   &kp LS(N8)      &kp LS(N9)      &none   &none   &kp RSFT    &kp RCTRL   &kp LALT    &kp RGUI    &none
                &none   &kp NUBS        &kp LS(NUBS)    &kp RA(APOS)    &kp RA(BSLH)    &none   &none   &none       &none       &kp RALT    &none       &none
                                                        &none           &none           &none   &none   &none       &none
            >;
        };
    };
};
